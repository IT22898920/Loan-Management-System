# DIRIYALANKA Loan Management System — Environment Template
# Copy this file to .env.local and fill in your Supabase project values.
# Do NOT commit .env.local — it contains live credentials.

# Public (safe to expose) — used in the browser client
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# SECRET — server-only, bypasses RLS on the entire dataset.
# Never expose this in client code or commit it. Rotate immediately if leaked.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-or-secret-key

# Cloudinary — used for profile photo CDN hosting (free 25 GB tier).
# Both values are PUBLIC (used by the browser to upload images).
# Set up an UNSIGNED upload preset named below at:
#   Cloudinary dashboard → Settings → Upload → Add upload preset → Signing Mode: Unsigned
# Recommended preset settings: image only, max 5 MB, folder = "diriyalanka/profile-photos".
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=diriyalanka_profile_photos
NEXT_PUBLIC_CLOUDINARY_MEMBER_UPLOAD_PRESET=diriyalanka_member_photos

# -----------------------------------------------------------------------------
# Netlify deployment — environment setup
# -----------------------------------------------------------------------------
# Set all of the variables above in the Netlify dashboard under:
#   Site settings -> Environment variables -> Add a variable
#
# Apply them to the appropriate deploy contexts (Production, Deploy previews,
# and Branch deploys) so both runtime and build steps can read them.
#
# Variables to configure in Netlify:
#   - NEXT_PUBLIC_SUPABASE_URL         (public, exposed to the browser)
#   - NEXT_PUBLIC_SUPABASE_ANON_KEY    (public, exposed to the browser)
#   - SUPABASE_SERVICE_ROLE_KEY        (SECRET — see security note below)
#
# SECURITY NOTE — SUPABASE_SERVICE_ROLE_KEY:
# This key bypasses Row Level Security and must NEVER reach the browser bundle.
# When adding it in Netlify, if the "Scopes" option is offered, mark it as
# "scope: Server-side only" (i.e. Functions / Builds only — NOT "All scopes"
# and NOT exposed to the Runtime/Client). This prevents Netlify from injecting
# the value into any client-side context. Do not prefix it with NEXT_PUBLIC_.

# -----------------------------------------------------------------------------
# STAGING-ONLY: Admin OTP 2FA bypass
# -----------------------------------------------------------------------------
# When set to the exact string 'true', admin login skips email OTP verification
# and goes straight to /admin/dashboard after password check. Intended ONLY for
# staging/QA where Supabase free-tier email rate limits make OTP unreliable.
#
# !!! DANGER — NEVER SET THIS ON PRODUCTION !!!
# Admin 2FA is a CBSL audit requirement. Disabling it in production removes the
# second factor protecting all financial data. Leave this variable UNSET (or
# absent entirely) in the Production Netlify context.
# DISABLE_ADMIN_OTP=true
